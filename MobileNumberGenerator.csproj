<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Panagis.MobileNumberGenerator</PackageId>
    <Version>1.0.0</Version>
    <Authors>Panagis</Authors>
    <Description>Generates random phone numbers that pass Google libphonenumber's MOBILE validation for a given country. Samples directly from that country's mobile numbering pattern (via Fare/Xeger) instead of returning the same fixed example number every time, and falls back to libphonenumber's own example number if no pattern-based candidate validates.</Description>
    <PackageTags>phone;phone-number;libphonenumber;mobile;random;test-data;faker;generator;fixtures</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryType>git</RepositoryType>
    <!-- TODO: replace with your own repo URL before publishing -->
    <RepositoryUrl>https://github.com/YOUR-GITHUB-USERNAME/MobileNumberGenerator</RepositoryUrl>
    <PackageProjectUrl>https://github.com/YOUR-GITHUB-USERNAME/MobileNumberGenerator</PackageProjectUrl>
    <Copyright>Copyright (c) 2026 Panagis</Copyright>
    <PackageOutputPath>./nupkg</PackageOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="libphonenumber-csharp" Version="9.0.39" />
    <PackageReference Include="Fare" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
